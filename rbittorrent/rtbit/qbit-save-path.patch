+#[tokio::test]
+async fn save_path_is_the_completed_folder_with_the_download_folder_as_temp_path() {
+    let (state, session, output) = qbit_state().await;
+    let download = output.path().to_string_lossy().into_owned();
+
+    // No completed folder: everything stays in the download folder.
+    let preferences = serde_json::to_value(
+        h_app_preferences(axum::extract::State(state.clone()))
+            .await
+            .0,
+    )
+    .unwrap();
+    assert_eq!(preferences["save_path"], download.as_str());
+    assert_eq!(preferences["temp_path_enabled"], false);
+    assert_eq!(preferences["temp_path"], "");
+    assert_eq!(
+        h_app_default_save_path(axum::extract::State(state.clone())).await,
+        download
+    );
+
+    // A completed folder is where finished torrents end up.
+    session.set_completed_folder(Some("/media/completed".into()));
+    let preferences = serde_json::to_value(
+        h_app_preferences(axum::extract::State(state.clone()))
+            .await
+            .0,
+    )
+    .unwrap();
+    assert_eq!(preferences["save_path"], "/media/completed");
+    assert_eq!(preferences["temp_path_enabled"], true);
+    assert_eq!(preferences["temp_path"], download.as_str());
+    assert_eq!(
+        h_app_default_save_path(axum::extract::State(state.clone())).await,
+        "/media/completed"
+    );
+
+    // A per-category template reports the folder the categories live in.
+    session.set_completed_folder(Some("/media/completed/{category}".into()));
+    assert_eq!(
+        h_app_default_save_path(axum::extract::State(state)).await,
+        "/media/completed"
+    );
+}
