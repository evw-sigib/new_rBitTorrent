+
+/// The save path and temp path as qBittorrent reports them. With a completed
+/// folder set, finished torrents end up there, so that is the save path, and
+/// unfinished ones sit in the download folder, which is what qBittorrent calls
+/// the temp path. Sonarr and Radarr check their remote path mappings against
+/// the save path. Without a completed folder, everything stays in the download
+/// folder.
+pub(super) fn qbit_save_paths(api: &Api) -> (String, Option<String>) {
+    let output = api.api_output_folder();
+    match api.api_completed_folder() {
+        Some(completed) => (completed_root(&completed), Some(output)),
+        None => (output, None),
+    }
+}
+
+/// A `{category}` template names one folder per category; the fixed part in
+/// front of the placeholder is the folder they all live in.
+fn completed_root(folder: &str) -> String {
+    match folder.split_once("{category}") {
+        Some((root, _)) if !root.trim_end_matches('/').is_empty() => {
+            root.trim_end_matches('/').to_owned()
+        }
+        _ => folder.to_owned(),
+    }
 }
 
