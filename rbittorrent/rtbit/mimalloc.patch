 url.workspace = true
 librqbit-dualstack-sockets.workspace = true
+# rBittorrent: mimalloc replaces musl's allocator, which serialises every
+# thread on one lock and keeps freed memory. `no_thp`: no transparent huge
+# pages, so idle RSS stays small on 4 GB Raspberry Pis.
+mimalloc = { version = "0.1.52", default-features = false, features = ["no_thp"] }
 
 [dev-dependencies]
 futures.workspace = true
