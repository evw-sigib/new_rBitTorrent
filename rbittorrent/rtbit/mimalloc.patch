 use tokio_util::sync::CancellationToken;
 
 mod config_file;
+
+// rBittorrent: mimalloc as the global allocator (lock-free per-thread heaps
+// instead of musl's single lock; freed pages go back to the kernel promptly).
+#[global_allocator]
+static GLOBAL: mimalloc::MiMalloc = mimalloc::MiMalloc;
