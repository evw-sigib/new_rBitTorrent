+    /// Move a finished torrent's files under `new_root` without stopping it:
+    /// each file is renamed and reopened under its own lock, so peers keep
+    /// reading and the tracker still hears about the completion. Only on one
+    /// filesystem; a failed rename rolls the others back.
+    pub(crate) fn relocate_files(&self, new_root: std::path::PathBuf) -> anyhow::Result<()> {
+        let g = self.locked.read();
+        let files = match &g.state {
+            ManagedTorrentState::Live(live) => &live.files,
+            ManagedTorrentState::Paused(paused) => &paused.files,
+            _ => bail!("torrent is not in a relocatable state"),
+        };
+        std::fs::create_dir_all(&new_root)
+            .with_context(|| format!("error creating destination directory {new_root:?}"))?;
+        files.move_root(&new_root)?;
+        *self.shared.output_folder_override.write() = new_root;
+        Ok(())
+    }
+
+    /// Point a stopped torrent at a copy of its files under `new_root` (a
+    /// move to another filesystem, which `set_location` refuses). The caller
+    /// copied every file there first; the storage is opened afresh on them.
+    pub(crate) fn rebind_location(&self, new_root: std::path::PathBuf) -> anyhow::Result<()> {
+        let metadata = self
+            .metadata
+            .load_full()
+            .context("torrent metadata was not loaded")?;
+        let mut g = self.locked.write();
+        let paused = match &mut g.state {
+            ManagedTorrentState::Paused(paused) => paused,
+            _ => bail!("torrent must be stopped before changing its location"),
+        };
+        let old_root =
+            std::mem::replace(&mut *self.shared.output_folder_override.write(), new_root);
+        match self
+            .shared
+            .storage_factory
+            .create_and_init(&self.shared, &metadata)
+        {
+            Ok(files) => {
+                paused.files = files;
+                Ok(())
+            }
+            Err(error) => {
+                *self.shared.output_folder_override.write() = old_root;
+                Err(error)
+            }
+        }
+    }
+
     pub fn shared(&self) -> &ManagedTorrentShared {
         &self.shared
     }
