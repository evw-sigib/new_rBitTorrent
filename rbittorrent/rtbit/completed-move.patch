+/// Whether a file move failed only because the target is on another
+/// filesystem (a rename cannot cross filesystems).
+fn crosses_devices(error: &anyhow::Error) -> bool {
+    error.chain().any(|cause| {
+        cause
+            .downcast_ref::<std::io::Error>()
+            .is_some_and(|e| e.kind() == std::io::ErrorKind::CrossesDevices)
+    })
+}
